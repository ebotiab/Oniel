{"annotations": [{"id": "proyecto-duplicacion-antequera-granada", "kind": "proyecto", "status": "licitado", "line_id": "lav-antequera-granada", "from_node_id": "bif-archidona", "to_node_id": "bif-la-chana", "from_name": "Bifurcación Archidona", "to_name": "Bifurcación La Chana", "km_from": 33.095, "km_to": 109.731, "segment_ids": ["lav-antequera-granada:bif-archidona:bif-riofrio", "lav-antequera-granada:bif-riofrio:loja", "lav-antequera-granada:loja:bif-tocon", "lav-antequera-granada:bif-tocon:bif-la-chana"], "node_id": null, "node_name": null, "geometry": null, "start_date": null, "expected_end_date": null, "expected_end_text": null, "ended_on": null, "title": "Duplicación de vía de la alta velocidad Antequera – Granada", "reason": "Duplicación de la vía de la línea de alta velocidad Antequera – Granada entre la bifurcación de Archidona y la bifurcación de La Chana, a la entrada de Granada.", "note": "Oniel solo ha comprobado en una fuente oficial la licitación de las obras de electrificación. La Variante de Loja, que evitará el paso por Loja en el centro del tramo, es un proyecto aparte.", "milestones": [{"date": "2025-11-18", "text": "Se licitan las obras de electrificación de la duplicación.", "source_id": "boe-b-2025-42383"}], "sources": [{"id": "boe-b-2025-42383", "name": "BOE-B-2025-42383: Licitación de la electrificación de la duplicación Antequera – Granada", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2025-42383"}], "checked_on": "2026-11-12", "schedule_note": null}, {"id": "proyecto-variante-de-loja", "kind": "proyecto", "status": "en_obras", "line_id": "lav-antequera-granada", "from_node_id": "bif-riofrio", "to_node_id": "bif-tocon", "from_name": "Bifurcación Riofrío", "to_name": "Bifurcación Tocón", "km_from": 52.111, "km_to": 78.521, "segment_ids": ["lav-antequera-granada:bif-riofrio:loja", "lav-antequera-granada:loja:bif-tocon"], "node_id": null, "node_name": null, "geometry": null, "start_date": null, "expected_end_date": null, "expected_end_text": null, "ended_on": null, "title": "Variante de Loja", "reason": "Trazado nuevo de unos 19 km en la línea de alta velocidad Antequera – Granada, al sur de Loja (Granada), entre Riofrío y Huétor-Tájar.", "note": "Se construye por tramos. En febrero de 2025, según el Ministerio de Transportes, el de Riofrío estaba en obras, el de la A-92 tenía las obras adjudicadas, el del Valle del Genil estaba pendiente de licitar y el viaducto sobre la línea convencional estaba terminado. Hoy los trenes pasan por Loja por la vía de la línea antigua, entre las bifurcaciones de Riofrío y de Tocón: son los tramos que la variante evitará. El mapa no dibuja su trazado.", "milestones": [{"date": "2010-04-20", "text": "El estudio informativo sale a información pública.", "source_id": "boe-b-2010-13908"}, {"date": "2011-04-07", "text": "Declaración de impacto ambiental favorable.", "source_id": "boe-a-2011-7131"}, {"date": "2011-04-28", "text": "Se aprueba definitivamente el estudio informativo.", "source_id": "boe-b-2011-16289"}, {"date": "2023-10-19", "text": "Se licitan las obras del tramo de Riofrío.", "source_id": "boe-b-2023-30155"}, {"date": "2024-07-31", "text": "Se licitan las obras del tramo de la A-92.", "source_id": "boe-b-2024-27845"}, {"date": "2025-02-21", "text": "El Ministerio de Transportes da el tramo de Riofrío por en obras.", "source_id": "moncloa-nota-variante-de-loja-2025-02"}, {"date": "2025-04-21", "text": "Se licitan las obras del tramo del Valle del Genil.", "source_id": "boe-b-2025-14442"}], "sources": [{"id": "moncloa-nota-variante-de-loja-2025-02", "name": "Nota de prensa del Ministerio de Transportes y Movilidad Sostenible sobre la visita a las obras de la Variante de Loja", "publisher": "Ministerio de Transportes y Movilidad Sostenible; La Moncloa", "url": "https://www.lamoncloa.gob.es/serviciosdeprensa/notasprensa/transportes-movilidad-sostenible/paginas/2025/210225-ave-madrid-granada.aspx"}, {"id": "boe-a-2011-7131", "name": "BOE-A-2011-7131: Declaración de impacto ambiental de la Variante de Loja", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-A-2011-7131"}, {"id": "boe-b-2011-16289", "name": "BOE-B-2011-16289: Aprobación definitiva del estudio informativo de la Variante de Loja", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2011-16289"}, {"id": "boe-b-2010-13908", "name": "BOE-B-2010-13908: Información pública del estudio informativo de la Variante de Loja", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2010-13908"}, {"id": "boe-b-2023-30155", "name": "BOE-B-2023-30155: Licitación de las obras del tramo Variante de Loja – Riofrío", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2023-30155"}, {"id": "boe-b-2024-27845", "name": "BOE-B-2024-27845: Licitación de las obras del tramo Variante de Loja – A-92", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2024-27845"}, {"id": "boe-b-2025-14442", "name": "BOE-B-2025-14442: Licitación de las obras del tramo Variante de Loja – Valle del Genil", "publisher": "Boletín Oficial del Estado", "url": "https://www.boe.es/diario_boe/txt.php?id=BOE-B-2025-14442"}], "checked_on": "2026-11-12", "schedule_note": null}], "line": {"id": "lav-antequera-granada", "name": "Línea de alta velocidad Antequera – Granada", "short_name": "036", "sort_order": 8, "zone": {"id": "andalucia", "name": "Andalucía", "sort_order": 9, "cities": ["Sevilla", "Córdoba", "Málaga", "Granada", "Jaén", "Cádiz", "Almería", "Huelva", "Algeciras"]}, "mode": "ferrocarril", "infrastructure_manager": {"id": "adif", "name": "Adif / Adif Alta Velocidad", "role": "administrador_infraestructura", "source_id": null, "timetable": null}, "operator_ids": ["renfe"], "gauge_mm": 1435, "electrification": "25 kV 50 Hz", "max_speed_kmh": 300, "opened_on": "2019-06-26", "length_km": 114.101, "reference_length_km": 114.249, "status": "disponible", "description": "El último trecho del camino por el que hoy va el tren de Madrid a Granada: sale de la línea de Córdoba a Málaga en Antequera-Santa Ana y llega a Granada pasando por Antequera y por Loja.\n\nSe abrió el 26 de junio de 2019. Hasta la bifurcación de Archidona tiene dos vías; desde allí hasta Granada, una sola. Entre las bifurcaciones de Riofrío y de Tocón los trenes pasan por Loja por la vía de la línea antigua, adaptada con un tercer carril, a mucha menos velocidad.\n\nAl sur de Loja se construye una variante que evitará ese paso, y Adif ha licitado las obras para poner la segunda vía en el resto. Sus puntos kilométricos continúan los de la línea de Córdoba a Málaga: Antequera-Santa Ana es el 96,8 y Granada, el 211.", "source_id": "osm-relation-2869549", "bypass_of": null, "node_count": 9, "segment_count": 8}, "nodes": [{"id": "antequera-santa-ana", "name": "Antequera-Santa Ana", "kind": "estacion", "rank": "principal", "lon": -4.719526, "lat": 37.070194, "adif_code": "02003", "description": "Estación abierta el 16 de diciembre de 2006, a 17 km al oeste de Antequera. Aquí se separan los caminos: la línea de Córdoba sigue hacia Málaga y, poco antes de los andenes, sale la de Granada. Tiene además un cambiador de ancho por el que los trenes de Madrid pasan a la línea convencional de Ronda y Algeciras.", "details": {}, "line_id": "lav-antequera-granada", "km": 0.0, "reference_pk_km": 96.772, "seq": 1}, {"id": "bif-bobadilla", "name": "Bifurcación Bobadilla", "kind": "bifurcacion", "rank": "secundario", "lon": -4.640431, "lat": 37.043828, "adif_code": null, "description": "Punto donde se une a la línea de Granada el enlace que viene de Málaga. Por él los trenes entre Málaga y Granada van directos, sin pasar por Antequera-Santa Ana, desde abril de 2022.", "details": {}, "line_id": "lav-antequera-granada", "km": 8.981, "reference_pk_km": 105.753, "seq": 2}, {"id": "antequera-av", "name": "Antequera AV", "kind": "estacion", "rank": "principal", "lon": -4.561372, "lat": 37.029466, "adif_code": "02030", "description": "Estación junto al casco urbano de Antequera, abierta el 25 de enero de 2023. Es la segunda estación de alta velocidad del municipio, con Antequera-Santa Ana.", "details": {}, "line_id": "lav-antequera-granada", "km": 16.614, "reference_pk_km": 113.417, "seq": 3}, {"id": "bif-archidona", "name": "Bifurcación Archidona", "kind": "bifurcacion", "rank": "secundario", "lon": -4.423125, "lat": 37.118794, "adif_code": null, "description": "Aquí las dos vías que vienen de Antequera se juntan en una. Desde este punto hasta Granada la línea es de vía única; Adif ha licitado las obras para poner la segunda vía.", "details": {}, "line_id": "lav-antequera-granada", "km": 33.095, "reference_pk_km": null, "seq": 4}, {"id": "bif-riofrio", "name": "Bifurcación Riofrío", "kind": "bifurcacion", "rank": "secundario", "lon": -4.215563, "lat": 37.137014, "adif_code": null, "description": "Final del trazado nuevo que viene de Antequera. Desde aquí hasta la bifurcación de Tocón los trenes de alta velocidad siguen por la vía de la línea antigua de Bobadilla a Granada, adaptada con un tercer carril, y bajan a Loja a poca velocidad.", "details": {}, "line_id": "lav-antequera-granada", "km": 52.111, "reference_pk_km": null, "seq": 5}, {"id": "loja", "name": "Loja", "kind": "estacion", "rank": "principal", "lon": -4.135651, "lat": 37.175237, "adif_code": "05012", "description": "Estación de la línea antigua de Bobadilla a Granada, reabierta el 26 de junio de 2019 con la llegada de la alta velocidad. El ferrocarril llegó a Loja desde Granada el 10 de diciembre de 1866.", "details": {}, "line_id": "lav-antequera-granada", "km": 62.606, "reference_pk_km": 159.45, "seq": 6}, {"id": "bif-tocon", "name": "Bifurcación Tocón", "kind": "bifurcacion", "rank": "secundario", "lon": -3.984568, "lat": 37.232174, "adif_code": null, "