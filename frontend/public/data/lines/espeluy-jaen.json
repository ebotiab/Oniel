/es/es/sala-de-prensa/noticias/2026/07/modificacion-servicio-media-distancia-jaen-madrid-e-almeria-madrid"}, {"id": "adif-salidas-y-llegadas", "name": "Salidas y llegadas de las estaciones de Santa Cruz de Mudela, Jaén, Ciudad Real y Córdoba", "publisher": "Adif", "url": "https://www.adif.es/viajeros/estaciones"}, {"id": "el-estrecho-digital-corte-algeciras", "name": "Noticia «Comienza el largo corte ferroviario entre Algeciras y Venta de Cárdenas por las obras de la Autopista Ferroviaria»", "publisher": "El Estrecho Digital", "url": "https://www.elestrechodigital.com/2026/09/07/comienza-el-largo-corte-ferroviario-entre-algeciras-y-venta-de-cardenas-por-las-obras-de-la-autopista-ferroviaria"}], "checked_on": "2026-11-10", "schedule_note": "Horario publicado; sin circulación real desde el 6 de septiembre de 2026 (Renfe)."}]}