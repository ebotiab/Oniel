# URL pública de la API (Render). Sin ella, el visor usa la instantánea estática de public/data.
VITE_API_URL=
# Fuerza el modo estático aunque haya API (útil para pruebas): estatico
VITE_DATA_MODE=
# Cuánto tiempo (ms) sondea el visor /healthz antes de dar la API por ausente; por defecto 150000
VITE_API_WAKE_MS=
# Token público de la aplicación web `oniel-visor` de Logfire. Solo lo usa el visor publicado en producción
# (docs/despliegue.md, «Errores del visor»); en local no hace falta y no se envía nada.
VITE_LOGFIRE_TOKEN=
