{
  "version": 8,
  "name": "Oniel papel",
  "metadata": {
    "oniel:palette": "papel",
    "oniel:source": "OpenFreeMap / OpenMapTiles / OpenStreetMap contributors"
  },
  "center": [-4.6, 38.9],
  "zoom": 6.5,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#EDEFE9" }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["==", ["get", "class"], "wood"]
      ],
      "paint": {
        "fill-color": "#E3E7DE",
        "fill-antialias": false,
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 10, 1]
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["match", ["get", "class"], ["grass", "farmland"], true, false]
      ],
      "paint": {
        "fill-color": "#E7EAE2",
        "fill-antialias": false,
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 11, 1]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 7,
      "filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
      "paint": {
        "fill-color": "#E7EAE2",
        "fill-antialias": false,
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse_urban",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["match", ["get", "class"], ["residential", "suburb", "neighbourhood", "commercial", "industrial", "retail"], true, false]
      ],
      "paint": {
        "fill-color": "#E4E7E0",
        "fill-antialias": false,
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 11, 1]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "fill-color": "#D3DCDF",
        "fill-antialias": true
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 7,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["river", "canal", "stream"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#CBD5D8",
        "line-width": [
          "interpolate", ["exponential", 1.3], ["zoom"],
          7, ["match", ["get", "class"], "river", 0.6, 0],
          10, ["match", ["get", "class"], "river", 1.2, "canal", 0.8, 0.4],
          14, ["match", ["get", "class"], "river", 3, "canal", 1.6, 1]
        ]
      }
    },
    {
      "id": "boundary_region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 4],
        ["!=", ["get", "maritime"], 1],
        ["!=", ["get", "disputed"], 1],
        ["!", ["has", "claimed_by"]]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#C0C6BF",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary_country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        ["!=", ["get", "maritime"], 1],
        ["!=", ["get", "disputed"], 1],
        ["!", ["has", "claimed_by"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#AEB5AF",
        "line-width": 1.2
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["tertiary", "minor", "service"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E2E5DE",
        "line-width": [
          "interpolate", ["exponential", 1.4], ["zoom"],
          11, ["match", ["get", "class"], "tertiary", 0.8, 0.4],
          14, ["match", ["get", "class"], "tertiary", 2, "minor", 1.4, 0.8]
        ]
      }
    },
    {
      "id": "road_primary_secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["primary", "secondary"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#DCE0D8",
        "line-width": [
          "interpolate", ["exponential", 1.4], ["zoom"],
          8, 0.5,
          11, ["match", ["get", "class"], "primary", 1.2, 0.9],
          14, ["match", ["get", "class"], "primary", 2.6, 2]
        ]
      }
    },
    {
      "id": "road_motorway_trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#D6DAD2",
        "line-width": [
          "interpolate", ["exponential", 1.3], ["zoom"],
          6, 1.2,
          10, 1.8,
          14, 3
        ]
      }
    },
    {
      "id": "rail_other_service",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "rail"],
        ["has", "service"]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#C3C8C0",
        "line-opacity": 0.6,
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 14, 0.8]
      }
    },
    {
      "id": "rail_other",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "rail"],
        ["!", ["has", "service"]]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#C3C8C0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 1.4],
        "line-dasharray": ["step", ["zoom"], ["literal", [1, 0]], 10, ["literal", [3, 3]]]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#DEE1DA",
        "fill-antialias": false,
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 14, 1]
      }
    },
    {
      "id": "water_name_point",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 6,
      "filter": ["match", ["geometry-type"], ["Point", "MultiPoint"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 13],
        "text-max-width": 6,
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#8B9490",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "water_name_line",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 6,
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 13],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#8B9490",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "waterway_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 11,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["river", "canal"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 400,
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#8B9490",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "road_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#8B9490",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 14, 12],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 13],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", ["get", "class"], "city"],
        [">", ["get", "rank"], 4]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 9, 13, 14, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_city_major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": [
        "all",
        ["==", ["get", "class"], "city"],
        ["<=", ["get", "rank"], 4]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 9, 14, 14, 16],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 7,
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 7, 12],
        "text-letter-spacing": 0.15,
        "text-transform": "uppercase",
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place_country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 13, 8, 16],
        "text-letter-spacing": 0.1,
        "text-max-width": 6.25
      },
      "paint": {
        "text-color": "#6B7470",
        "text-halo-color": "#EDEFE9",
        "text-halo-width": 1.6
      }
    }
  ]
}
