# secrets (`.env*` tal cual: es la línea que busca la CLI de Vercel antes de añadirla)
.env*
!.env.example
.logfire/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node
node_modules/
dist/
frontend/test-results/
frontend/playwright-report/

# Enlace local de la CLI de Vercel (docs/despliegue.md); sin barra final, por lo mismo
.vercel

# misc
.DS_Store
*.log

# Copia de CLAUDE.md que Codex genera por su cuenta al importar el proyecto (cambia `.claude` por
# `.Codex`). Oniel no mantiene un AGENTS.md: las instrucciones están en CLAUDE.md. Entró dos veces
# por error con un `git add -A` (PR 182 y 184).
/AGENTS.md

# Enlaces de skills que crea library-skills en la raíz (apuntan a backend/.venv). Las skills propias
# del proyecto sí se versionan: cada una necesita aquí su línea, o git la ignora.
/.agents/
/.claude/skills/*
!/.claude/skills/anadir-linea/
!/.claude/skills/revisar-interrupciones/
!/.claude/skills/poner-rama-al-dia/
!/.claude/skills/refresco-gtfs/
# Copias sin cambios de maplibre/maplibre-agent-skills (cada carpeta lleva su ORIGEN.md y su licencia)
!/.claude/skills/maplibre-v6-migration/
!/.claude/skills/maplibre-source-wiring/
!/.claude/skills/maplibre-tile-sources/
