# secrets (`.env*` tal cual: es la línea que busca la CLI de Vercel antes de añadirla)
.env*
!.env.example
.logfire/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# node
node_modules/
dist/
frontend/test-results/
frontend/playwright-report/

# Enlace local de la CLI de Vercel (docs/despliegue.md); sin barra final, por lo mismo
.vercel

# misc
.DS_Store
*.log

# Las dos herramientas comparten procedimientos. Se versionan los del proyecto y sus
# enlaces de Codex; los procedimientos que instalan las dependencias quedan en cada equipo.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/anadir-linea
!/.agents/skills/maplibre-source-wiring
!/.agents/skills/maplibre-tile-sources
!/.agents/skills/maplibre-v6-migration
!/.agents/skills/poner-rama-al-dia
!/.agents/skills/refresco-gtfs
!/.agents/skills/revisar-interrupciones
/.claude/skills/*
!/.claude/skills/anadir-linea/
!/.claude/skills/revisar-interrupciones/
!/.claude/skills/poner-rama-al-dia/
!/.claude/skills/refresco-gtfs/
# Copias sin cambios de maplibre/maplibre-agent-skills (cada carpeta lleva su ORIGEN.md y su licencia)
!/.claude/skills/maplibre-v6-migration/
!/.claude/skills/maplibre-source-wiring/
!/.claude/skills/maplibre-tile-sources/
