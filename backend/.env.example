# Copia a backend/.env para desarrollo local. Ninguna variable es obligatoria.
ONIEL_DATABASE_URL=postgresql://oniel:oniel@localhost:5433/oniel
ONIEL_ENVIRONMENT=local
# Logfire: deja LOGFIRE_TOKEN vacío para no enviar nada. En el servidor se define en el entorno.
# LOGFIRE_TOKEN=
# ONIEL_IMPORT_ON_START=1   # solo en la imagen Docker: importa los datos antes de arrancar la API (Render sin cron)
