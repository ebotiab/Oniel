{
  "line": {
    "id": "eje-atlantico",
    "name": "Línea de alta velocidad A Coruña – Santiago – Vigo",
    "short_name": "822, 824 y 850",
    "sort_order": 31,
    "zone": "galicia",
    "mode": "ferrocarril",
    "infrastructure_manager": "adif",
