  "attribute_sections": [
    {"attribute": "proteccion_tren", "from_node": "monforte-del-cid-av", "to_node": "bif-vinalopo", "value": "ertms_n2_asfa", "source_id": "adif-declaracion-red-2026-mapas", "checked_on": "2026-11-13", "note": "El mapa 4 no dibuja el enlace aparte: junto a la bifurcación de Murcia rotula lo de la línea 046, a la que el enlace da acceso. Símbolos «ERTMS N2» y «ASFA - AV», los mismos que lleva la línea de Alicante en ese punto. Las vías del enlace en OSM (ref=048) llevan railway:etcs=2."},
    {"attribute": "bloqueo", "from_node": "monforte-del-cid-av", "to_node": "bif-vinalopo", "value": "bca", "source_id": "adif-declaracion-red-2026-mapas", "checked_on": "2026-11-13", "note": "El mapa 4 no dibuja el enlace aparte: junto a la bifurcación de Murcia rotula lo de la línea 046, a la que el enlace da acceso. Trazo rosa y rótulo «BCA», como en las dos líneas que une."},
