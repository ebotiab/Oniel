  "line": {
    "id": "lav-valladolid-leon",
    "name": "Línea de alta velocidad Valladolid – Palencia – León",
    "short_name": "080 y 084",
    "sort_order": 25,
    "zone": "castilla-y-leon",
    "mode": "ferrocarril",
    "infrastructure_manager": "adif",
    "gauge_mm": 1435,
    "electrification": "25 kV 50 Hz",
