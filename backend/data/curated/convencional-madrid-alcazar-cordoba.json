  "corridor_filter": {
    "description": "Se importan los viajes del GTFS que paran en al menos dos nodos de la línea y en alguna de sus estaciones exclusivas (las que no comparte con la alta velocidad). Así entran los Media Distancia Madrid–Jaén, Madrid–Alcázar–Albacete y Alcázar–Ciudad Real, el Alvia Barcelona–Córdoba por Alcázar y los trenes Córdoba–Jaén y de Proximidad de Córdoba, y quedan fuera los AVE. Los Intercity y Alvia Madrid-Atocha Cercanías – Andalucía, que solo paran en Madrid, Ciudad Real y Córdoba, entran por las reglas de route_overrides.",
    "required_stop_ids": [],
    "any_of_stop_ids": ["60200", "60202", "60203", "60206", "60207", "60300", "60301", "60400", "50002", "50100", "50102", "50200", "50202", "50207", "50300", "50400", "50403", "50407", "50413", "50417"],
    "min_node_stops": 2
  },
